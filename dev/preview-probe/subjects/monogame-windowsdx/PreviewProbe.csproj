<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Builds, but cannot run, on macOS and Linux: enough to check it compiles. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PreviewProbe</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWSDX</DefineConstants>
  </PropertyGroup>

  <!-- The game is the DesktopGL subject's. This subject keeps its own copy of
       the file the probe edits, and its own way of sharing frames. -->
  <ItemGroup>
    <Compile Include="..\monogame-desktopgl\*.cs"
             Exclude="..\monogame-desktopgl\ReloadMarker.cs;..\monogame-desktopgl\SharedSurfaces.cs"
             Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.6" />
  </ItemGroup>

</Project>

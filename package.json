{
  "name": "@playstead/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "build": "vp run --filter @playstead/web --filter @playstead/server --filter @playstead/desktop build",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "icons:export": "node scripts/export-icons.ts",
    "icons:check": "node scripts/export-icons.ts --check",
    "smoke:desktop": "node apps/desktop/scripts/smoke-test.ts",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "knip:check": "knip --no-config-hints",
    "test": "vp run -r test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "sync:repos": "node scripts/sync-reference-repos.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "tsc-rs": "0.7.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}

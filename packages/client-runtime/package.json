{
  "name": "@playstead/client-runtime",
  "private": true,
  "description": "The clients' connection and shared state: one connection owner per environment, reconnecting, RPC sessions and thread streams.",
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./connection": {
      "types": "./src/connection/index.ts",
      "import": "./src/connection/index.ts"
    },
    "./operations/threadTitle": {
      "types": "./src/operations/threadTitle.ts",
      "import": "./src/operations/threadTitle.ts"
    },
    "./state/archivedThreads": {
      "types": "./src/state/archivedThreads.ts",
      "import": "./src/state/archivedThreads.ts"
    },
    "./state/filesystem": {
      "types": "./src/state/filesystem.ts",
      "import": "./src/state/filesystem.ts"
    },
    "./state/projects": {
      "types": "./src/state/projects.ts",
      "import": "./src/state/projects.ts"
    },
    "./state/thread": {
      "types": "./src/state/thread.ts",
      "import": "./src/state/thread.ts"
    },
    "./state/threadOrder": {
      "types": "./src/state/threadOrder.ts",
      "import": "./src/state/threadOrder.ts"
    },
    "./state/threadSettled": {
      "types": "./src/state/threadSettled.ts",
      "import": "./src/state/threadSettled.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "@playstead/contracts": "workspace:*",
    "@playstead/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}

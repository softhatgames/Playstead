{
  "name": "@playstead/contracts",
  "private": true,
  "description": "Effect Schema contracts for everything that crosses a process boundary: the RPC contract, orchestration commands and events, settings and the desktop bridge.",
  "type": "module",
  "exports": {
    "./applicationEvent": {
      "types": "./src/applicationEvent.ts",
      "import": "./src/applicationEvent.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./src/auth.ts"
    },
    "./baseSchemas": {
      "types": "./src/baseSchemas.ts",
      "import": "./src/baseSchemas.ts"
    },
    "./desktopBootstrap": {
      "types": "./src/desktopBootstrap.ts",
      "import": "./src/desktopBootstrap.ts"
    },
    "./environment": {
      "types": "./src/environment.ts",
      "import": "./src/environment.ts"
    },
    "./environmentHttp": {
      "types": "./src/environmentHttp.ts",
      "import": "./src/environmentHttp.ts"
    },
    "./filesystem": {
      "types": "./src/filesystem.ts",
      "import": "./src/filesystem.ts"
    },
    "./ipc": {
      "types": "./src/ipc.ts",
      "import": "./src/ipc.ts"
    },
    "./model": {
      "types": "./src/model.ts",
      "import": "./src/model.ts"
    },
    "./orchestrationProject": {
      "types": "./src/orchestrationProject.ts",
      "import": "./src/orchestrationProject.ts"
    },
    "./orchestrationV2": {
      "types": "./src/orchestrationV2.ts",
      "import": "./src/orchestrationV2.ts"
    },
    "./project": {
      "types": "./src/project.ts",
      "import": "./src/project.ts"
    },
    "./providerInstance": {
      "types": "./src/providerInstance.ts",
      "import": "./src/providerInstance.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts"
    },
    "./threadSearch": {
      "types": "./src/threadSearch.ts",
      "import": "./src/threadSearch.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc-rs --noEmit"
  },
  "dependencies": {
    "@playstead/shared": "workspace:*",
    "effect": "catalog:"
  }
}
